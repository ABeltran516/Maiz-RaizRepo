---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Tarjeta de producto reutilizable.
interface Props {
  nombre: string;
  precio: number;
  peso: string;
  imagen: ImageMetadata;
  alt?: string;
  disponible?: boolean;
}

const { nombre, precio, peso, imagen, alt, disponible = true } = Astro.props;
---

<div class="Products-cards" data-agotado={!disponible}>
  <Image
    src={imagen}
    alt={alt ?? nombre}
    widths={[240, 480, 720]}
    sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
    loading="lazy"
  />
  {!disponible && <span class="Agotado-badge">Agotado</span>}
  <div class="Product-info">
    <h3>{nombre}</h3>
    <p>${precio} MXN</p>
    <p>{peso}</p>
  </div>
</div>
