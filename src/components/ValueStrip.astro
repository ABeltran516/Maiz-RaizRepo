---
// Tira de valores bajo el hero (del diseño de Claude Design).
const items = [
  'Sin ingredientes de origen animal',
  'Una opción más saludable',
];
---

<section class="Value-strip">
  <div class="Value-strip-inner">
    {
      items.map((t) => (
        <span class="Value-item">
          <span class="Value-check">✔</span>
          {t}
        </span>
      ))
    }
  </div>
</section>
